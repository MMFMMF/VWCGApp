---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import HowItWorks from '../components/marketing/HowItWorks.astro';
import SampleReport from '../components/marketing/SampleReport.astro';
import ComparisonTable from '../components/marketing/ComparisonTable.astro';
import CTA from '../components/marketing/CTA.astro';
import Footer from '../components/marketing/Footer.astro';

const pageTitle = 'Free Business Gap Assessment — 10 Strategic Tools | VWCG';
const pageDescription = 'Free diagnostic tools that score your leadership, operations, AI readiness, and execution in 10 minutes. No signup. Instant results. PDF export. Used by 1,200+ business owners.';
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main>
    <Hero ctaHref="/invite" />
    <HowItWorks ctaHref="/invite" />
    <SampleReport />
    <ComparisonTable />
    <CTA ctaHref="/invite" />
  </main>
  <Footer />
</MarketingLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
