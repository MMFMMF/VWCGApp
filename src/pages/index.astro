---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import HowItWorks from '../components/marketing/HowItWorks.astro';
import SampleReport from '../components/marketing/SampleReport.astro';
import ComparisonTable from '../components/marketing/ComparisonTable.astro';
import CTA from '../components/marketing/CTA.astro';
import Footer from '../components/marketing/Footer.astro';

const pageTitle = 'Free Business Gap Assessment — Find What\'s Holding You Back';
const pageDescription = 'Free diagnostic tools that score your leadership, operations, strategy, and execution in 10 minutes. No signup required. Instant results with PDF export.';
---

<MarketingLayout title={pageTitle} description={pageDescription}>
  <main>
    <Hero ctaHref="/app" />
    <HowItWorks ctaHref="/app" />
    <SampleReport />
    <ComparisonTable />
    <CTA ctaHref="/app" />
  </main>
  <Footer />
</MarketingLayout>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
