---
import CounterIsland from '../islands/CounterIsland';

interface Props {
  ctaHref?: string;
}

const { ctaHref = '/app' } = Astro.props;
---

<section class="relative bg-gradient-to-br from-indigo-600 via-indigo-700 to-purple-800 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-32">
    <div class="text-center">
      <!-- Headline (HERO-01) - Pain-focused messaging -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold tracking-tight">
        Stop Running Your Business<br class="hidden sm:inline" />
        <span class="text-indigo-200">Blind</span>
      </h1>

      <!-- Subheadline (HERO-02) - Clear value proposition above the fold -->
      <p class="mt-6 text-lg sm:text-xl lg:text-2xl text-indigo-100 max-w-3xl mx-auto">
        Get a complete diagnostic of your leadership, operations, and strategy gaps—in just 10 minutes. No consultants, no guessing.
      </p>

      <!-- Animated Statistics (HERO-03) - Count-up effect with viewport trigger -->
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        <div class="flex flex-col items-center">
          <div class="text-4xl sm:text-5xl font-bold text-white">
            <CounterIsland
              end={11}
              suffix="+"
              duration={2.0}
              description="11 plus assessment tools available"
              client:visible
            />
          </div>
          <p class="mt-2 text-sm sm:text-base text-indigo-200">Assessment Tools</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl sm:text-5xl font-bold text-white">
            <CounterIsland
              end={500}
              suffix="+"
              duration={2.5}
              description="500 plus business owners served"
              client:visible
            />
          </div>
          <p class="mt-2 text-sm sm:text-base text-indigo-200">Business Owners Served</p>
        </div>
        <div class="flex flex-col items-center">
          <div class="text-4xl sm:text-5xl font-bold text-white">
            <CounterIsland
              end={10}
              suffix=""
              duration={1.8}
              description="10 minutes to complete assessment"
              client:visible
            />
          </div>
          <p class="mt-2 text-sm sm:text-base text-indigo-200">Minutes to Complete</p>
        </div>
      </div>

      <!-- CTA Buttons (HERO-04 & HERO-05) - Primary and secondary CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-lg bg-white text-indigo-700 hover:bg-indigo-50 shadow-lg hover:shadow-xl transition-all"
        >
          Start Free Assessment
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a
          href="#sample-report"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-lg border-2 border-white/30 text-white hover:bg-white/10 transition-all"
        >
          See Sample Report
        </a>
      </div>

      <!-- Trust Signals (TRS-01 to TRS-04) - 4 specific trust signals in responsive grid -->
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto text-sm text-indigo-100">
        <div class="flex flex-col items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="font-medium">No Email Required</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="font-medium">No Account Required</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="font-medium">100% Private</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="font-medium">Results in 10 Minutes</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave Divider -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto">
      <path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white"/>
    </svg>
  </div>
</section>
