---
interface Props {
  ctaHref?: string;
}

const { ctaHref = '/invite' } = Astro.props;
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden bg-slate-950">
  <!-- Animated gradient orbs -->
  <div class="absolute top-[-20%] left-[-10%] w-[600px] h-[600px] rounded-full bg-indigo-600/20 blur-[120px] animate-pulse"></div>
  <div class="absolute bottom-[-20%] right-[-10%] w-[500px] h-[500px] rounded-full bg-violet-600/15 blur-[100px] animate-pulse" style="animation-delay: 1s;"></div>
  <div class="absolute top-[40%] right-[20%] w-[300px] h-[300px] rounded-full bg-amber-500/10 blur-[80px] animate-pulse" style="animation-delay: 2s;"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Copy -->
      <div>
        <!-- Audience qualifier pill -->
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 rounded-full px-4 py-1.5 mb-8">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-sm text-slate-300 font-medium">For founders & ops leaders · $1M–$50M businesses</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-bold text-white tracking-tight leading-[1.08]">
          The $15k strategy diagnosis.
          <span class="block mt-2 bg-gradient-to-r from-amber-300 to-amber-500 bg-clip-text text-transparent">Free. 10 minutes.</span>
        </h1>

        <p class="mt-6 text-lg text-slate-400 leading-relaxed max-w-lg">
          Score your leadership, operations, AI readiness, and execution across 10 strategic dimensions. See where you're strong, where you're bleeding money, and what to fix first.
        </p>

        <!-- CTA -->
        <div class="mt-10 flex flex-col sm:flex-row gap-4">
          <a
            href={ctaHref}
            class="group inline-flex items-center justify-center px-8 py-4 text-lg font-bold rounded-xl bg-amber-400 text-slate-900 hover:bg-amber-300 shadow-[0_0_40px_rgba(251,191,36,0.3)] hover:shadow-[0_0_60px_rgba(251,191,36,0.4)] transition-all duration-300"
          >
            Start Free Assessment
            <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
          </a>
          <a href="#sample-report" class="inline-flex items-center justify-center px-6 py-4 text-base font-medium rounded-xl text-slate-300 border border-slate-700 hover:border-slate-500 hover:text-white transition-all">
            See sample report
          </a>
        </div>

        <!-- Trust signals -->
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            No signup required
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            100% private
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            PDF export
          </span>
        </div>
      </div>

      <!-- Right: Visual preview card -->
      <div class="hidden lg:block relative">
        <div class="relative bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 shadow-2xl">
          <!-- Mini report preview -->
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            </div>
            <div>
              <p class="text-white font-semibold text-sm">Business Assessment</p>
              <p class="text-slate-500 text-xs">10 strategic dimensions</p>
            </div>
          </div>

          <!-- Score bars -->
          <div class="space-y-4">
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <span class="text-slate-400">AI Readiness</span>
                <span class="text-indigo-400 font-bold">72%</span>
              </div>
              <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-indigo-500 to-indigo-400 rounded-full" style="width: 72%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <span class="text-slate-400">Leadership DNA</span>
                <span class="text-violet-400 font-bold">85%</span>
              </div>
              <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-violet-500 to-violet-400 rounded-full" style="width: 85%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <span class="text-slate-400">Operational Efficiency</span>
                <span class="text-emerald-400 font-bold">61%</span>
              </div>
              <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-emerald-500 to-emerald-400 rounded-full" style="width: 61%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-xs mb-1.5">
                <span class="text-slate-400">Execution Capacity</span>
                <span class="text-amber-400 font-bold">78%</span>
              </div>
              <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-amber-500 to-amber-400 rounded-full" style="width: 78%"></div>
              </div>
            </div>
          </div>

          <!-- Insight teaser -->
          <div class="mt-6 p-3 bg-red-500/10 border border-red-500/20 rounded-lg">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
              <span class="text-xs font-semibold text-red-400 uppercase">High Priority</span>
            </div>
            <p class="text-xs text-slate-400">Execution capacity limits strategic pillars to 3...</p>
          </div>
        </div>

        <!-- Decorative floating elements -->
        <div class="absolute -top-4 -right-4 w-20 h-20 bg-amber-400/10 rounded-xl blur-xl"></div>
        <div class="absolute -bottom-6 -left-6 w-24 h-24 bg-indigo-500/10 rounded-xl blur-xl"></div>
      </div>
    </div>
  </div>
</section>
