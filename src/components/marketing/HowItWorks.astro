---
interface Props {
  ctaHref?: string;
}

const { ctaHref = '/invite' } = Astro.props;
---

<section class="py-20 sm:py-28 bg-white relative overflow-hidden">
  <!-- Subtle background accent -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-indigo-50 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3"></div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold text-indigo-600 uppercase tracking-wider">3 steps · 10 minutes</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-gray-900">
        From questions to action plan
      </h2>
    </div>

    <!-- Steps as cards with big numbers -->
    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      <!-- Step 1 -->
      <div class="group relative bg-gradient-to-b from-slate-50 to-white border border-gray-200 rounded-2xl p-8 hover:border-indigo-300 hover:shadow-lg transition-all duration-300">
        <div class="text-6xl font-black text-indigo-100 group-hover:text-indigo-200 transition-colors absolute top-4 right-6">1</div>
        <div class="relative">
          <div class="w-12 h-12 rounded-xl bg-indigo-600 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Enter your invite code</h3>
          <p class="text-gray-600 leading-relaxed">
            Request a free access code or find one in our blog. One code, full access to the complete strategic assessment.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="group relative bg-gradient-to-b from-slate-50 to-white border border-gray-200 rounded-2xl p-8 hover:border-violet-300 hover:shadow-lg transition-all duration-300">
        <div class="text-6xl font-black text-violet-100 group-hover:text-violet-200 transition-colors absolute top-4 right-6">2</div>
        <div class="relative">
          <div class="w-12 h-12 rounded-xl bg-violet-600 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Answer honestly</h3>
          <p class="text-gray-600 leading-relaxed">
            Rate your business across 10 strategic dimensions — leadership, operations, AI readiness, execution, and more. Takes about 10 minutes. No trick questions — just real operational data.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="group relative bg-gradient-to-b from-slate-50 to-white border border-gray-200 rounded-2xl p-8 hover:border-emerald-300 hover:shadow-lg transition-all duration-300">
        <div class="text-6xl font-black text-emerald-100 group-hover:text-emerald-200 transition-colors absolute top-4 right-6">3</div>
        <div class="relative">
          <div class="w-12 h-12 rounded-xl bg-emerald-600 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Get your report</h3>
          <p class="text-gray-600 leading-relaxed">
            Instant scores, cross-tool insights, and a prioritized action plan. Download as PDF. Share with your team.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
