---
interface Props {
  ctaHref?: string;
}

const { ctaHref = '/app' } = Astro.props;
---

<section class="py-16 sm:py-20 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold leading-tight">
      Your Competition Is Already<br class="hidden sm:inline" />
      Benchmarking. Are You?
    </h2>
    <p class="mt-4 text-lg text-slate-300 max-w-xl mx-auto">
      Most users complete all 10 assessments in one sitting. Start with one and see what you've been missing.
    </p>

    <div class="mt-10">
      <a
        href={ctaHref}
        class="group inline-flex items-center justify-center px-10 py-5 text-xl font-bold rounded-xl bg-amber-400 text-slate-900 hover:bg-amber-300 shadow-lg shadow-amber-400/20 hover:shadow-xl transition-all duration-200"
      >
        Choose Your First Assessment
        <svg class="ml-3 w-6 h-6 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
      </a>
    </div>

    <p class="mt-6 text-sm text-slate-400">
      No email. No signup. No credit card. Ever.
    </p>
  </div>
</section>
