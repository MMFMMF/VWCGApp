<section id="comparison" class="py-16 sm:py-24 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900">
        What You'd Learn in a $15k Engagement
      </h2>
      <p class="mt-3 text-gray-600 max-w-lg mx-auto">
        Same strategic insights. Free. In the time it takes to drink a coffee.
      </p>
    </div>

    <!-- Desktop table -->
    <div class="hidden md:block">
      <table class="w-full border-collapse" aria-label="Comparison of VWCGApp vs consultant vs DIY">
        <thead>
          <tr>
            <th scope="col" class="p-4 text-left text-sm font-medium text-gray-500 w-1/4">
              <span class="sr-only">Feature</span>
            </th>
            <th scope="col" class="p-4 text-center w-1/4 bg-indigo-50 border-x-2 border-t-2 border-indigo-500 rounded-t-lg relative">
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-amber-400 text-slate-900 text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">
                Free
              </span>
              <span class="font-bold text-gray-900">VWCG</span>
            </th>
            <th scope="col" class="p-4 text-center w-1/4 font-medium text-gray-500">Consultant</th>
            <th scope="col" class="p-4 text-center w-1/4 font-medium text-gray-500">Doing Nothing</th>
          </tr>
        </thead>
        <tbody class="text-sm">
          <tr class="border-b border-gray-100">
            <th scope="row" class="p-4 text-left font-medium text-gray-900">Time to insight</th>
            <td class="p-4 text-center bg-indigo-50 border-x-2 border-indigo-500 font-semibold text-indigo-700">10 minutes</td>
            <td class="p-4 text-center text-gray-500">2–4 weeks</td>
            <td class="p-4 text-center text-gray-400 italic">Never</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th scope="row" class="p-4 text-left font-medium text-gray-900">Cost</th>
            <td class="p-4 text-center bg-indigo-50 border-x-2 border-indigo-500 font-semibold text-indigo-700">$0</td>
            <td class="p-4 text-center text-gray-500">$5k–$20k</td>
            <td class="p-4 text-center text-gray-400 italic">$0 upfront, costly later</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th scope="row" class="p-4 text-left font-medium text-gray-900">Covers</th>
            <td class="p-4 text-center bg-indigo-50 border-x-2 border-indigo-500 font-semibold text-indigo-700">10 dimensions</td>
            <td class="p-4 text-center text-gray-500">1–2 focus areas</td>
            <td class="p-4 text-center text-gray-400 italic">Your gut feeling</td>
          </tr>
          <tr class="border-b border-gray-100">
            <th scope="row" class="p-4 text-left font-medium text-gray-900">Privacy</th>
            <td class="p-4 text-center bg-indigo-50 border-x-2 border-indigo-500 font-semibold text-indigo-700">100% browser-only</td>
            <td class="p-4 text-center text-gray-500">Shared with third party</td>
            <td class="p-4 text-center text-gray-400">—</td>
          </tr>
          <tr>
            <th scope="row" class="p-4 text-left font-medium text-gray-900">Cross-tool synthesis</th>
            <td class="p-4 text-center bg-indigo-50 border-x-2 border-b-2 border-indigo-500 rounded-b-lg">
              <svg class="inline-block w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
            </td>
            <td class="p-4 text-center">
              <svg class="inline-block w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </td>
            <td class="p-4 text-center">
              <svg class="inline-block w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Mobile stacked cards -->
    <div class="md:hidden space-y-4">
      {[
        { label: 'Time to insight', vwcg: '10 minutes', consultant: '2–4 weeks', diy: 'Never' },
        { label: 'Cost', vwcg: '$0', consultant: '$5k–$20k', diy: '$0 upfront, costly later' },
        { label: 'Covers', vwcg: '10 dimensions', consultant: '1–2 focus areas', diy: 'Your gut feeling' },
        { label: 'Privacy', vwcg: '100% browser-only', consultant: 'Shared with third party', diy: '—' },
      ].map((row) => (
        <div class="bg-gray-50 rounded-xl p-4">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">{row.label}</p>
          <div class="space-y-2">
            <div class="flex justify-between items-center bg-indigo-50 rounded-lg px-3 py-2">
              <span class="text-sm font-bold text-indigo-700">VWCG</span>
              <span class="text-sm font-semibold text-indigo-700">{row.vwcg}</span>
            </div>
            <div class="flex justify-between items-center px-3 py-1.5">
              <span class="text-sm text-gray-500">Consultant</span>
              <span class="text-sm text-gray-500">{row.consultant}</span>
            </div>
            <div class="flex justify-between items-center px-3 py-1.5">
              <span class="text-sm text-gray-400">Doing Nothing</span>
              <span class="text-sm text-gray-400 italic">{row.diy}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
