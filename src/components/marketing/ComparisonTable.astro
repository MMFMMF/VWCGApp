<section id="comparison" class="py-20 sm:py-28 bg-slate-950 text-white relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(99,102,241,0.08),transparent_50%)]"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_80%,rgba(139,92,246,0.06),transparent_50%)]"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <span class="text-sm font-semibold text-indigo-400 uppercase tracking-wider">Why this exists</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold">
        What a $15k engagement covers.<br class="hidden sm:inline" />
        <span class="text-slate-400">Yours for $0.</span>
      </h2>
    </div>

    <!-- Comparison cards — not a table -->
    <div class="grid md:grid-cols-3 gap-5">
      <!-- VWCG — highlighted -->
      <div class="relative bg-gradient-to-b from-indigo-600/20 to-indigo-600/5 border-2 border-indigo-500 rounded-2xl p-7 order-first">
        <!-- Badge -->
        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
          <span class="bg-amber-400 text-slate-900 text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wide">Free</span>
        </div>
        <h3 class="text-xl font-bold text-white mt-2 mb-6 text-center">VWCG</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <div>
              <span class="font-semibold text-white">10 minutes</span>
              <p class="text-sm text-slate-400">to first insight</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <div>
              <span class="font-semibold text-white">$0 forever</span>
              <p class="text-sm text-slate-400">no upsell, no paywall</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <div>
              <span class="font-semibold text-white">10 dimensions</span>
              <p class="text-sm text-slate-400">full strategic coverage</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <div>
              <span class="font-semibold text-white">100% private</span>
              <p class="text-sm text-slate-400">everything stays in your browser</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <div>
              <span class="font-semibold text-white">Cross-tool synthesis</span>
              <p class="text-sm text-slate-400">insights across all assessments</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Consultant -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-7">
        <h3 class="text-xl font-bold text-slate-400 mb-6 text-center">Hiring a Consultant</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 flex items-center justify-center text-slate-600 mt-0.5 flex-shrink-0">—</span>
            <div>
              <span class="font-medium text-slate-300">2–4 weeks</span>
              <p class="text-sm text-slate-500">meetings, interviews, delays</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 flex items-center justify-center text-slate-600 mt-0.5 flex-shrink-0">—</span>
            <div>
              <span class="font-medium text-slate-300">$5k–$20k</span>
              <p class="text-sm text-slate-500">before any recommendations</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 flex items-center justify-center text-slate-600 mt-0.5 flex-shrink-0">—</span>
            <div>
              <span class="font-medium text-slate-300">1–2 focus areas</span>
              <p class="text-sm text-slate-500">narrow scope for the price</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-5 h-5 flex items-center justify-center text-slate-600 mt-0.5 flex-shrink-0">—</span>
            <div>
              <span class="font-medium text-slate-300">Shared with third party</span>
              <p class="text-sm text-slate-500">your data leaves your hands</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-400/60 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            <div>
              <span class="font-medium text-slate-300">No cross-analysis</span>
              <p class="text-sm text-slate-500">siloed reports</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Doing Nothing -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-7">
        <h3 class="text-xl font-bold text-slate-400 mb-6 text-center">Doing Nothing</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-400/60 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            <div>
              <span class="font-medium text-slate-300">Never</span>
              <p class="text-sm text-slate-500">blind spots persist</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-400/60 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            <div>
              <span class="font-medium text-slate-300">$0 upfront</span>
              <p class="text-sm text-slate-500">costly mistakes later</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-400/60 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            <div>
              <span class="font-medium text-slate-300">Gut feeling</span>
              <p class="text-sm text-slate-500">no data-backed decisions</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-400/60 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            <div>
              <span class="font-medium text-slate-300">No visibility</span>
              <p class="text-sm text-slate-500">you don't know what you don't know</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-red-400/60 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            <div>
              <span class="font-medium text-slate-300">No synthesis</span>
              <p class="text-sm text-slate-500">disconnected intuitions</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
