---
import '@/styles/global.css';

// Self-hosted fonts via @fontsource
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/lexend/400.css';
import '@fontsource/lexend/500.css';
import '@fontsource/lexend/600.css';
import '@fontsource/lexend/700.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage = '/og-image.png', canonical } = Astro.props;
const siteUrl = 'https://vwcgapp.com';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <title>{title}</title>
  <link rel="canonical" href={canonical || `${siteUrl}${Astro.url.pathname}`} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
  <meta property="og:type" content="website" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "VWCGApp — Business Gap Assessment",
    "applicationCategory": "BusinessApplication",
    "description": description,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "operatingSystem": "Web Browser"
  })} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-white text-gray-900 antialiased font-sans">
  <!-- Sticky navigation -->
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-14">
        <a href="/" class="flex items-center gap-2">
          <span class="text-lg font-bold text-gray-900">VWCG</span>
          <span class="hidden sm:inline text-xs text-gray-400 border-l border-gray-200 pl-2">by World Consulting Group</span>
        </a>
        <div class="flex items-center gap-4 sm:gap-6">
          <a href="/blog" class="hidden sm:inline text-sm text-gray-600 hover:text-gray-900 transition-colors">Blog</a>
          <a
            href="/app"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-600 text-white hover:bg-indigo-500 transition-colors"
          >
            Start Assessment
          </a>
        </div>
      </div>
    </div>
  </header>

  <slot />
</body>
</html>
